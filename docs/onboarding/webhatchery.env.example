# Copy the values you are authorized to use to D:\WebHatchery\.env.
# Do not commit the real file. Normal development needs no secrets.

# Local deployment roots (optional; these are the publisher defaults).
PREVIEW_ROOT=D:\xampp\htdocs
PRODUCTION_ROOT=D:\WebHatcheryProduction

# FTP production publishing (required only with publish.ps1 -FTP).
FTP_SERVER=ftp.example.com
FTP_USERNAME=replace-me
FTP_PASSWORD=replace-me
FTP_PORT=21
FTP_REMOTE_ROOT=/
FTP_USE_SSL=false
FTP_PASSIVE_MODE=true

# Optional Project Roost deployment tracking.
PROJECT_ROOST_PUBLISH_TOKEN=replace-me
PROJECT_ROOST_API_URL_PREVIEW=http://127.0.0.1/project_roost/api/v1
PROJECT_ROOST_API_URL_PRODUCTION=https://webhatchery.au/project_roost/api/v1
